<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CheharTemple" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
    </style>

    <style name="Theme.CheharTemple.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.CheharTemple</item>
    </style>
</resources>
